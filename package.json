{
  "name": "idempotency-rehearsal",
  "version": "0.1.0",
  "description": "Prove duplicate and reordered webhooks produce one business effect.",
  "type": "module",
  "license": "MIT",
  "author": "Sociobot (Param Factory)",
  "homepage": "https://idempotency-rehearsal.sociobot.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B-Divyesh/sf-idempotency-rehearsal.git"
  },
  "keywords": [
    "idempotency",
    "webhook",
    "testing",
    "retries",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "files": [
    "dist/package",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/package/index.cjs",
  "module": "./dist/package/index.js",
  "types": "./dist/package/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/package/index.d.ts",
      "import": "./dist/package/index.js",
      "require": "./dist/package/index.cjs"
    }
  },
  "bin": {
    "idempotency-rehearsal": "./dist/package/cli.js"
  },
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "node scripts/a11y.mjs",
    "typecheck": "tsc --noEmit",
    "build:package": "tsup src/index.ts src/cli.ts --format esm,cjs --dts --clean --out-dir dist/package --target node20 --sourcemap",
    "build:site": "vite build --config site/vite.config.ts",
    "build": "npm run typecheck && npm run build:package && npm run build:site",
    "pack:check": "npm run build:package && npm pack --dry-run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@types/node": "^24.3.0",
    "jsdom": "^26.1.0",
    "playwright": "1.58.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
